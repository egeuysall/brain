{
  "name": "brain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ryva knowledge repository with Astro content browser",
  "scripts": {
    "dev": "bun run sync-content && astro dev",
    "build": "bun run sync-content && astro build",
    "preview": "astro preview",
    "check": "bun run sync-content && astro check",
    "sync-content": "node tooling/scripts/sync-content.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3",
    "@astrojs/check": "^0.9.8",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "jsxSingleQuote": false,
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "none",
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "importOrder": [
      "^react$",
      "",
      "^next",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^@/features/(.*)$",
      "",
      "^@/components/(.*)$",
      "",
      "^@/lib/(.*)$",
      "",
      "^@/hooks/(.*)$",
      "",
      "^@/public/(.*)$",
      "",
      "^[./]"
    ]
  }
}
