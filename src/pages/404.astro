---
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout title="Not Found">
  <main class="mx-auto flex min-h-screen max-w-4xl items-center px-6 py-10">
    <div>
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-muted">
        404
      </p>
      <h1 class="mt-3 text-4xl leading-none font-medium uppercase tracking-[-0.08em]">
        Page Not Found
      </h1>
      <p class="mt-4 max-w-xl text-muted">
        This Astro shell exposes mirrored repo content from the main index only.
      </p>
      <a href="/" class="mt-6 inline-block underline underline-offset-4">Return to index</a>
    </div>
  </main>
</BaseLayout>
