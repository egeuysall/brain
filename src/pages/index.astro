---
import { getCollection, render } from "astro:content"

import { buildFileTree, FileTree } from "@/components/file-tree"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import { Separator } from "@/components/ui/separator"
import { ScrollArea } from "@/components/ui/scroll-area"
import BaseLayout from "@/layouts/BaseLayout.astro"

const docs = (await getCollection("docs")).sort((left, right) =>
  left.data.generatedPath.localeCompare(right.data.generatedPath)
)

const query = Astro.url.searchParams.get("q")?.trim() ?? ""
const requestedDocPath = Astro.url.searchParams.get("doc")?.trim() ?? ""
const normalizedQuery = query.toLowerCase()

const filteredDocs = normalizedQuery
  ? docs.filter(doc =>
      [
        doc.data.title,
        doc.data.description ?? "",
        doc.data.generatedPath,
        ...(Array.isArray(doc.data.tags) ? doc.data.tags : [])
      ]
        .join(" ")
        .toLowerCase()
        .includes(normalizedQuery)
    )
  : docs

const currentDoc =
  filteredDocs.find(doc => doc.data.generatedPath === requestedDocPath) ??
  filteredDocs[0] ??
  docs.find(doc => doc.data.generatedPath === requestedDocPath) ??
  null

const rendered = currentDoc ? await render(currentDoc) : null
const tableOfContents = (rendered?.headings ?? []).filter(
  (heading: { depth: number }) => heading.depth <= 2
)

const buildDocHref = (generatedPath: string) => {
  const params = new URLSearchParams()
  params.set("doc", generatedPath)

  if (query) {
    params.set("q", query)
  }

  return `/?${params.toString()}`
}

const tree = buildFileTree(
  filteredDocs.map(doc => ({
    title: doc.data.title,
    generatedPath: doc.data.generatedPath,
    href: buildDocHref(doc.data.generatedPath)
  }))
)
---

<BaseLayout title="Ryva Brain">
  <div class="mx-auto min-h-screen max-w-[1600px] px-4 py-4 sm:px-6 sm:py-6">
    <header class="border-b border-line pb-3">
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.22em] text-muted">
        Ryva Brain
      </p>
    </header>

    <main class="mt-4 grid gap-4 lg:grid-cols-[20rem_minmax(0,1fr)]">
      <aside class="border border-line bg-panel">
        <div class="p-3">
          <form method="get" class="flex items-center gap-2">
            <Input
              name="q"
              defaultValue={query}
              type="search"
              placeholder="Filter files..."
              aria-label="Filter documents"
            />
            <Button type="submit" variant="outline">
              Find
            </Button>
          </form>
          <div class="mt-2 flex items-center justify-between font-mono text-[0.62rem] uppercase tracking-[0.18em] text-muted">
            <span>File Tree</span>
            {query ? <a href="/" class="underline underline-offset-4">Reset</a> : <span>All</span>}
          </div>
        </div>

        <Separator />

        <ScrollArea className="h-[calc(100vh-9.5rem)]">
          <FileTree nodes={tree} selectedPath={currentDoc?.data.generatedPath} />
        </ScrollArea>
      </aside>

      <section class="border border-line bg-panel">
        {currentDoc && rendered ? (
          <>
            <div class="p-5 sm:p-7">
              <div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_14rem] xl:items-start">
                <div>
                  <p class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-muted">
                    {currentDoc.data.kind}
                  </p>
                  <h2 class="mt-2 max-w-4xl text-[1.55rem] leading-[0.95] font-medium uppercase tracking-[-0.05em] sm:text-[2.25rem]">
                    {currentDoc.data.title}
                  </h2>
                  {currentDoc.data.description && (
                    <p class="mt-3 max-w-3xl text-[0.94rem] leading-7 text-muted">
                      {currentDoc.data.description}
                    </p>
                  )}
                </div>

                <div class="space-y-3 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-muted">
                  <div>
                    <p>MDX</p>
                    <p class="mt-1 break-all text-foreground">{currentDoc.data.generatedPath}</p>
                  </div>
                  {currentDoc.data.date && (
                    <div>
                      <p>Date</p>
                      <p class="mt-1 text-foreground">{currentDoc.data.date}</p>
                    </div>
                  )}
                  {tableOfContents.length > 0 && (
                    <div>
                      <p>Jump</p>
                      <ul class="mt-2 space-y-2 normal-case tracking-normal">
                        {tableOfContents.slice(0, 8).map((heading: { slug: string; text: string }) => (
                          <li>
                            <a href={`#${heading.slug}`} class="underline underline-offset-4">
                              {heading.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </div>

            <Separator />

            <article class="p-5 sm:p-7">
              <div class="doc-prose max-w-none" data-doc-body>
                <rendered.Content />
              </div>
            </article>
          </>
        ) : (
          <div class="p-8">
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-muted">
              No Match
            </p>
            <p class="mt-3 max-w-xl text-base">
              No markdown files matched the current filter. Reset the query or run the sync
              script if you added new source files.
            </p>
          </div>
        )}
      </section>
    </main>
  </div>
</BaseLayout>
