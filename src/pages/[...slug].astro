---
import DocsApp from "@/components/docs-app.astro"
import { getDocsView, listDocs, normalizeDocPath, toRoutePath } from "@/lib/docs"

export async function getStaticPaths() {
  const docs = await listDocs()

  return docs.flatMap(doc => {
    const filePath = doc.filePath ?? doc.id
    const cleanPath = toRoutePath(filePath)
    return [
      {
        params: {
          slug: cleanPath
        }
      }
    ]
  })
}

const selectedPath = normalizeDocPath(Astro.params.slug)
const { currentDoc, rendered, sidebarDocs } = await getDocsView(selectedPath)

if (
  !currentDoc ||
  toRoutePath(currentDoc.filePath ?? currentDoc.id) !== (selectedPath ?? "")
) {
  Astro.response.status = 404
}
---

<DocsApp
  currentDoc={currentDoc}
  rendered={rendered}
  sidebarDocs={sidebarDocs}
/>
